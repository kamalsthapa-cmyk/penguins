penguins %>%
ggplot(mapping = aes(x=bill_length_mm, fill=species)) +
geom_histogram() +
facet_wrap(~species, nrow=3) +
theme_bw()
ggplot(data=penguins,mapping= aes(x=body_mass_g, y=flipper_length_mm, color=species)) +
geom_point()+
geom_smooth(method="lm")+
facet_wrap(~island)+
theme_minimal()
